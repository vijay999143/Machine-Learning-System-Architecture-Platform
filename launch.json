{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: FastAPI Platform (F5 to Run)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.app:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": false
    },
    {
      "name": "Python: Run All 25 Pytest Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v"
      ]
    }
  ]
}
